# Cuenta de Gmail que envía los correos del formulario de contacto (remitente).
GMAIL_USER=

# Contraseña de aplicación de esa cuenta de Gmail (NO la contraseña normal).
# Se genera en myaccount.google.com → Seguridad → Contraseñas de aplicaciones
# (requiere tener activada la verificación en 2 pasos).
GMAIL_APP_PASSWORD=

# Correo(s) donde quieres recibir las consultas del formulario.
# Para cambiarlo (ej. al desplegar en Vercel) solo edita este valor.
CONTACT_EMAIL_TO=tomasurizark@gmail.com
